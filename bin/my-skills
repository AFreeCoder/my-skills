#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  my-skills list
  my-skills third-party list
  my-skills third-party add <name-or-source> [skills add options...]
  my-skills init [--project <path>]
  my-skills link [--project <path>] <skill-name> [<skill-name>...]
  my-skills unlink [--project <path>] <skill-name> [<skill-name>...]

Environment:
  MY_SKILLS_HOME     Override the my-skills repository path.
  MY_SKILLS_CATALOG  Override the third-party skills catalog path.
  MY_SKILLS_NPX      Override the npx command used by third-party add.
USAGE
}

die() {
  printf 'my-skills: %s\n' "$*" >&2
  exit 1
}

script_home() {
  local source dir target
  source=${BASH_SOURCE[0]}

  while [ -L "$source" ]; do
    dir=$(cd -P "$(dirname "$source")" && pwd)
    target=$(readlink "$source")
    case "$target" in
      /*) source=$target ;;
      *) source=$dir/$target ;;
    esac
  done

  dir=$(cd -P "$(dirname "$source")" && pwd)
  cd -P "$dir/.." && pwd
}

canonical_dir() {
  [ -d "$1" ] || return 1
  cd -P "$1" && pwd
}

project_root() {
  local explicit=$1 git_root

  if [ -n "$explicit" ]; then
    canonical_dir "$explicit" || die "project path is not a directory: $explicit"
    return
  fi

  if git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    canonical_dir "$git_root"
    return
  fi

  pwd -P
}

validate_skill_name() {
  local name=$1
  case "$name" in
    -*|'') return 1 ;;
  esac
  case "$name" in
    *[!a-z0-9-]*) return 1 ;;
  esac
  return 0
}

parse_project_option() {
  local out_var=$1
  shift
  local project=''
  local args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        [ "$#" -ge 2 ] || die "--project requires a path"
        project=$2
        shift 2
        ;;
      --project=*)
        project=${1#--project=}
        [ -n "$project" ] || die "--project requires a path"
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          args+=("$1")
          shift
        done
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  printf -v "$out_var" '%s' "$project"
  REMAINING_ARGS=()
  if [ "${#args[@]}" -gt 0 ]; then
    REMAINING_ARGS=("${args[@]}")
  fi
}

ensure_init() {
  local project=$1 agents_dir claude_dir claude_skills target resolved expected

  agents_dir=$project/.agents/skills
  claude_dir=$project/.claude
  claude_skills=$claude_dir/skills

  mkdir -p "$agents_dir" "$claude_dir"

  if [ -L "$claude_skills" ]; then
    resolved=$(canonical_dir "$claude_skills") || die "conflicting broken symlink: $claude_skills"
    expected=$(canonical_dir "$agents_dir")
    if [ "$resolved" = "$expected" ]; then
      printf 'already configured: %s -> ../.agents/skills\n' "$claude_skills"
      return 0
    fi
    target=$(readlink "$claude_skills")
    die "conflicting symlink: $claude_skills -> $target"
  fi

  if [ -e "$claude_skills" ]; then
    die "path already exists and is not a symlink: $claude_skills"
  fi

  ln -s ../.agents/skills "$claude_skills"
  printf 'created: %s -> ../.agents/skills\n' "$claude_skills"
}

skill_source() {
  printf '%s/skills/%s' "$MY_SKILLS_HOME" "$1"
}

catalog_path() {
  printf '%s\n' "${MY_SKILLS_CATALOG:-$MY_SKILLS_HOME/catalog/third-party-skills.tsv}"
}

is_catalog_comment_or_empty() {
  local name=$1
  [ -z "$name" ] && return 0
  case "$name" in
    '#'* ) return 0 ;;
  esac
  return 1
}

catalog_lookup() {
  local wanted=$1 catalog name source default_scope description
  catalog=$(catalog_path)
  [ -f "$catalog" ] || return 1

  while IFS="$(printf '\t')" read -r name source default_scope description; do
    is_catalog_comment_or_empty "$name" && continue
    if [ "$name" = "$wanted" ]; then
      printf '%s\t%s\t%s\t%s\n' "$name" "$source" "$default_scope" "$description"
      return 0
    fi
  done < "$catalog"

  return 1
}

looks_like_skill_source() {
  case "$1" in
    http://*|https://*|git@*|*/*) return 0 ;;
  esac
  return 1
}

preflight_skill_sources() {
  local name src
  for name in "$@"; do
    validate_skill_name "$name" || die "invalid skill name: $name"
    src=$(skill_source "$name")
    [ -d "$src" ] || die "skill source does not exist: $src"
    [ -f "$src/SKILL.md" ] || die "skill source is missing SKILL.md: $src"
  done
}

preflight_link_targets() {
  local project=$1 name target src resolved expected existing
  shift

  for name in "$@"; do
    target=$project/.agents/skills/$name
    src=$(skill_source "$name")
    expected=$(canonical_dir "$src")

    if [ -L "$target" ]; then
      resolved=$(canonical_dir "$target") || die "conflicting broken symlink: $target"
      if [ "$resolved" = "$expected" ]; then
        continue
      fi
      existing=$(readlink "$target")
      die "conflicting symlink: $target -> $existing"
    fi

    if [ -e "$target" ]; then
      die "path already exists and is not a symlink: $target"
    fi
  done
}

preflight_unlink_targets() {
  local project=$1 name target src resolved expected existing
  shift

  for name in "$@"; do
    validate_skill_name "$name" || die "invalid skill name: $name"
    target=$project/.agents/skills/$name
    src=$(skill_source "$name")
    expected=$(canonical_dir "$src") || die "skill source does not exist: $src"

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
      continue
    fi

    if [ ! -L "$target" ]; then
      die "path exists and is not a symlink: $target"
    fi

    resolved=$(canonical_dir "$target") || die "conflicting broken symlink: $target"
    if [ "$resolved" != "$expected" ]; then
      existing=$(readlink "$target")
      die "refusing to unlink non-my-skills target: $target -> $existing"
    fi
  done
}

cmd_init() {
  local project_option project
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -eq 0 ] || die "init does not accept skill names"
  project=$(project_root "$project_option")
  ensure_init "$project"
}

cmd_list() {
  [ "$#" -eq 0 ] || die "list does not accept arguments"

  local skill_dir
  for skill_dir in "$MY_SKILLS_HOME"/skills/*; do
    [ -d "$skill_dir" ] || continue
    [ -f "$skill_dir/SKILL.md" ] || continue
    basename "$skill_dir"
  done | sort
}

cmd_third_party_list() {
  [ "$#" -eq 0 ] || die "third-party list does not accept arguments"

  local catalog name source default_scope description
  catalog=$(catalog_path)
  [ -f "$catalog" ] || die "third-party catalog does not exist: $catalog"

  printf 'name\tscope\tsource\tdescription\n'
  while IFS="$(printf '\t')" read -r name source default_scope description; do
    is_catalog_comment_or_empty "$name" && continue
    printf '%s\t%s\t%s\t%s\n' "$name" "$default_scope" "$source" "$description"
  done < "$catalog"
}

cmd_third_party_add() {
  [ "$#" -gt 0 ] || die "third-party add requires a catalog name or source"

  local input=$1 source default_scope entry arg has_global=0 force_project=0 npx_cmd
  shift

  if entry=$(catalog_lookup "$input"); then
    source=$(printf '%s\n' "$entry" | cut -f2)
    default_scope=$(printf '%s\n' "$entry" | cut -f3)
  elif looks_like_skill_source "$input"; then
    source=$input
    default_scope=project
  else
    die "unknown third-party skill catalog entry: $input"
  fi

  [ -n "$source" ] || die "third-party catalog entry has empty source: $input"

  REMAINING_ARGS=()
  for arg in "$@"; do
    case "$arg" in
      -g|--global) has_global=1 ;;
      --project) force_project=1; continue ;;
    esac
    REMAINING_ARGS+=("$arg")
  done

  npx_cmd=${MY_SKILLS_NPX:-npx}
  if [ "$default_scope" = "global" ] && [ "$has_global" -eq 0 ] && [ "$force_project" -eq 0 ]; then
    if [ "${#REMAINING_ARGS[@]}" -gt 0 ]; then
      "$npx_cmd" skills@latest add "$source" --global "${REMAINING_ARGS[@]}"
    else
      "$npx_cmd" skills@latest add "$source" --global
    fi
  else
    if [ "${#REMAINING_ARGS[@]}" -gt 0 ]; then
      "$npx_cmd" skills@latest add "$source" "${REMAINING_ARGS[@]}"
    else
      "$npx_cmd" skills@latest add "$source"
    fi
  fi
}

cmd_third_party() {
  case "${1:-}" in
    list|ls)
      shift
      cmd_third_party_list "$@"
      ;;
    add)
      shift
      cmd_third_party_add "$@"
      ;;
    --help|-h|'')
      cat <<'USAGE'
Usage:
  my-skills third-party list
  my-skills third-party add <name-or-source> [skills add options...]

Examples:
  my-skills third-party list
  my-skills third-party add vercel-agent-skills --list
  my-skills third-party add vercel-labs/agent-skills --skill vercel-optimize --yes
  my-skills third-party add some-global-skill --project
USAGE
      ;;
    *)
      die "unknown third-party command: $1"
      ;;
  esac
}

cmd_link() {
  local project_option project name target src resolved
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -gt 0 ] || die "link requires at least one skill name"

  project=$(project_root "$project_option")
  preflight_skill_sources "${REMAINING_ARGS[@]}"
  preflight_link_targets "$project" "${REMAINING_ARGS[@]}"
  ensure_init "$project"

  for name in "${REMAINING_ARGS[@]}"; do
    target=$project/.agents/skills/$name
    src=$(skill_source "$name")
    resolved=$(canonical_dir "$src")
    if [ -L "$target" ]; then
      printf 'already linked: %s -> %s\n' "$target" "$resolved"
    else
      ln -s "$resolved" "$target"
      printf 'linked: %s -> %s\n' "$target" "$resolved"
    fi
  done
}

cmd_unlink() {
  local project_option project name target
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -gt 0 ] || die "unlink requires at least one skill name"

  project=$(project_root "$project_option")
  preflight_unlink_targets "$project" "${REMAINING_ARGS[@]}"

  for name in "${REMAINING_ARGS[@]}"; do
    target=$project/.agents/skills/$name
    if [ -L "$target" ]; then
      rm "$target"
      printf 'unlinked: %s\n' "$target"
    else
      printf 'already absent: %s\n' "$target"
    fi
  done
}

MY_SKILLS_HOME=${MY_SKILLS_HOME:-$(script_home)}
MY_SKILLS_HOME=$(canonical_dir "$MY_SKILLS_HOME") || die "MY_SKILLS_HOME is not a directory: $MY_SKILLS_HOME"

REMAINING_ARGS=()

case "${1:-}" in
  list)
    shift
    cmd_list "$@"
    ;;
  third-party)
    shift
    cmd_third_party "$@"
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  link)
    shift
    cmd_link "$@"
    ;;
  unlink)
    shift
    cmd_unlink "$@"
    ;;
  --help|-h)
    usage
    ;;
  '')
    usage >&2
    exit 1
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
