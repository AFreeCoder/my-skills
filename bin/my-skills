#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  my-skills list
  my-skills external add <name> <source> [--scope project|global] [--description <text>]
  my-skills add [--project <path>] [--scope project|global] <name-or-source> [skills add options...]
  my-skills init [--project <path>]
  my-skills link [--project <path>] <skill-name> [<skill-name>...]
  my-skills unlink [--project <path>] <skill-name> [<skill-name>...]

Environment:
  MY_SKILLS_HOME     Override the my-skills repository path.
  MY_SKILLS_EXTERNAL Override the external skills catalog JSON path.
  MY_SKILLS_NODE     Override the node command used to read JSON.
  MY_SKILLS_NPX      Override the npx command used by add for external skills.
USAGE
}

die() {
  printf 'my-skills: %s\n' "$*" >&2
  exit 1
}

script_home() {
  local source dir target
  source=${BASH_SOURCE[0]}

  while [ -L "$source" ]; do
    dir=$(cd -P "$(dirname "$source")" && pwd)
    target=$(readlink "$source")
    case "$target" in
      /*) source=$target ;;
      *) source=$dir/$target ;;
    esac
  done

  dir=$(cd -P "$(dirname "$source")" && pwd)
  cd -P "$dir/.." && pwd
}

canonical_dir() {
  [ -d "$1" ] || return 1
  cd -P "$1" && pwd
}

project_root() {
  local explicit=$1 git_root

  if [ -n "$explicit" ]; then
    canonical_dir "$explicit" || die "project path is not a directory: $explicit"
    return
  fi

  if git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    canonical_dir "$git_root"
    return
  fi

  pwd -P
}

validate_skill_name() {
  local name=$1
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

parse_project_option() {
  local out_var=$1
  shift
  local project=''
  local args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        [ "$#" -ge 2 ] || die "--project requires a path"
        project=$2
        shift 2
        ;;
      --project=*)
        project=${1#--project=}
        [ -n "$project" ] || die "--project requires a path"
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          args+=("$1")
          shift
        done
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  printf -v "$out_var" '%s' "$project"
  REMAINING_ARGS=()
  if [ "${#args[@]}" -gt 0 ]; then
    REMAINING_ARGS=("${args[@]}")
  fi
}

ensure_init() {
  local project=$1 agents_dir claude_dir claude_skills target resolved expected

  agents_dir=$project/.agents/skills
  claude_dir=$project/.claude
  claude_skills=$claude_dir/skills

  mkdir -p "$agents_dir" "$claude_dir"

  if [ -L "$claude_skills" ]; then
    resolved=$(canonical_dir "$claude_skills") || die "conflicting broken symlink: $claude_skills"
    expected=$(canonical_dir "$agents_dir")
    if [ "$resolved" = "$expected" ]; then
      printf 'already configured: %s -> ../.agents/skills\n' "$claude_skills"
      return 0
    fi
    target=$(readlink "$claude_skills")
    die "conflicting symlink: $claude_skills -> $target"
  fi

  if [ -e "$claude_skills" ]; then
    die "path already exists and is not a symlink: $claude_skills"
  fi

  ln -s ../.agents/skills "$claude_skills"
  printf 'created: %s -> ../.agents/skills\n' "$claude_skills"
}

skill_source() {
  printf '%s/skills/%s' "$MY_SKILLS_HOME" "$1"
}

catalog_path() {
  if [ -n "${MY_SKILLS_EXTERNAL:-}" ]; then
    printf '%s\n' "$MY_SKILLS_EXTERNAL"
    return
  fi
  printf '%s\n' "${MY_SKILLS_CATALOG:-$MY_SKILLS_HOME/external/skills.json}"
}

node_cmd() {
  printf '%s\n' "${MY_SKILLS_NODE:-node}"
}

self_skill_exists() {
  local src
  validate_skill_name "$1" || return 1
  src=$(skill_source "$1")
  [ -d "$src" ] && [ -f "$src/SKILL.md" ]
}

catalog_lookup() {
  local wanted=$1 catalog
  catalog=$(catalog_path)
  [ -f "$catalog" ] || return 1
  "$(node_cmd)" -e '
const fs = require("fs");
const catalogPath = process.argv[1];
const wanted = process.argv[2];
const catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
const entries = Array.isArray(catalog.third_party) ? catalog.third_party : [];
const entry = entries.find((item) => item && item.name === wanted);
if (!entry) process.exit(1);
console.log([entry.name || "", entry.source || "", entry.scope || "project", entry.description || ""].join("\t"));
' "$catalog" "$wanted"
}

catalog_list() {
  local catalog
  catalog=$(catalog_path)
  [ -f "$catalog" ] || return 0
  "$(node_cmd)" -e '
const fs = require("fs");
const catalogPath = process.argv[1];
const catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
const entries = Array.isArray(catalog.third_party) ? catalog.third_party : [];
for (const entry of entries) {
  if (!entry || !entry.name || !entry.source) continue;
  console.log([entry.name, "favorite", entry.scope || "project", entry.source, entry.description || ""].join("\t"));
}
' "$catalog"
}

catalog_add() {
  local name=$1 source=$2 scope=$3 description=$4 catalog
  catalog=$(catalog_path)
  mkdir -p "$(dirname "$catalog")"
  "$(node_cmd)" -e '
const fs = require("fs");
const catalogPath = process.argv[1];
const name = process.argv[2];
const source = process.argv[3];
const scope = process.argv[4];
const description = process.argv[5];

let catalog = {};
if (fs.existsSync(catalogPath)) {
  catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
}
if (!Array.isArray(catalog.third_party)) {
  catalog.third_party = [];
}
if (catalog.third_party.some((entry) => entry && entry.name === name)) {
  console.error(`my-skills: external skill already exists: ${name}`);
  process.exit(2);
}
catalog.third_party.push({ name, source, scope, description });
fs.writeFileSync(catalogPath, `${JSON.stringify(catalog, null, 2)}\n`);
' "$catalog" "$name" "$source" "$scope" "$description"
  printf 'added external skill: %s -> %s (%s)\n' "$name" "$source" "$scope"
}

cmd_external_add() {
  local name='' source='' scope='project' description='' arg

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --scope)
        [ "$#" -ge 2 ] || die "--scope requires project or global"
        scope=$2
        shift 2
        ;;
      --scope=*)
        scope=${1#--scope=}
        shift
        ;;
      --description)
        [ "$#" -ge 2 ] || die "--description requires text"
        description=$2
        shift 2
        ;;
      --description=*)
        description=${1#--description=}
        shift
        ;;
      --help|-h)
        cat <<'USAGE'
Usage:
  my-skills external add <name> <source> [--scope project|global] [--description <text>]

Examples:
  my-skills external add emilkowalski-skills emilkowalski/skills --description "Design and animation skills"
  my-skills external add some-global-skill owner/repo --scope global
USAGE
        return 0
        ;;
      --*)
        die "unknown external add option: $1"
        ;;
      *)
        if [ -z "$name" ]; then
          name=$1
        elif [ -z "$source" ]; then
          source=$1
        else
          die "unexpected external add argument: $1"
        fi
        shift
        ;;
    esac
  done

  [ -n "$name" ] || die "external add requires a name"
  [ -n "$source" ] || die "external add requires a source"
  validate_skill_name "$name" || die "invalid external skill name: $name"
  looks_like_skill_source "$source" || die "external skill source must be owner/repo, URL, or git remote: $source"
  case "$scope" in
    project|global) ;;
    *) die "--scope must be project or global" ;;
  esac

  catalog_add "$name" "$source" "$scope" "$description"
}

cmd_external() {
  case "${1:-}" in
    add)
      shift
      cmd_external_add "$@"
      ;;
    --help|-h|'')
      cat <<'USAGE'
Usage:
  my-skills external add <name> <source> [--scope project|global] [--description <text>]
USAGE
      ;;
    *)
      die "unknown external command: $1"
      ;;
  esac
}

looks_like_skill_source() {
  case "$1" in
    http://*|https://*|git@*|*/*) return 0 ;;
  esac
  return 1
}

preflight_skill_sources() {
  local name src
  for name in "$@"; do
    validate_skill_name "$name" || die "invalid skill name: $name"
    src=$(skill_source "$name")
    [ -d "$src" ] || die "skill source does not exist: $src"
    [ -f "$src/SKILL.md" ] || die "skill source is missing SKILL.md: $src"
  done
}

preflight_link_targets() {
  local project=$1 name target src resolved expected existing
  shift

  for name in "$@"; do
    target=$project/.agents/skills/$name
    src=$(skill_source "$name")
    expected=$(canonical_dir "$src")

    if [ -L "$target" ]; then
      resolved=$(canonical_dir "$target") || die "conflicting broken symlink: $target"
      if [ "$resolved" = "$expected" ]; then
        continue
      fi
      existing=$(readlink "$target")
      die "conflicting symlink: $target -> $existing"
    fi

    if [ -e "$target" ]; then
      die "path already exists and is not a symlink: $target"
    fi
  done
}

preflight_unlink_targets() {
  local project=$1 name target src resolved expected existing
  shift

  for name in "$@"; do
    validate_skill_name "$name" || die "invalid skill name: $name"
    target=$project/.agents/skills/$name
    src=$(skill_source "$name")
    expected=$(canonical_dir "$src") || die "skill source does not exist: $src"

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
      continue
    fi

    if [ ! -L "$target" ]; then
      die "path exists and is not a symlink: $target"
    fi

    resolved=$(canonical_dir "$target") || die "conflicting broken symlink: $target"
    if [ "$resolved" != "$expected" ]; then
      existing=$(readlink "$target")
      die "refusing to unlink non-my-skills target: $target -> $existing"
    fi
  done
}

cmd_init() {
  local project_option project
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -eq 0 ] || die "init does not accept skill names"
  project=$(project_root "$project_option")
  ensure_init "$project"
}

cmd_list() {
  [ "$#" -eq 0 ] || die "list does not accept arguments"

  local skill_dir
  printf 'name\ttype\tscope\tsource\tdescription\n'
  for skill_dir in "$MY_SKILLS_HOME"/skills/*; do
    [ -d "$skill_dir" ] || continue
    [ -f "$skill_dir/SKILL.md" ] || continue
    printf '%s\tself-built\tproject\t%s\t-\n' "$(basename "$skill_dir")" "$skill_dir"
  done | sort
  catalog_list
}

run_third_party_add() {
  local source=$1 default_scope=$2 arg has_global=0 npx_cmd
  shift 2

  [ -n "$source" ] || die "third-party catalog entry has empty source"

  REMAINING_ARGS=()
  for arg in "$@"; do
    case "$arg" in
      -g|--global) has_global=1 ;;
    esac
    REMAINING_ARGS+=("$arg")
  done

  npx_cmd=${MY_SKILLS_NPX:-npx}
  if [ "$default_scope" = "global" ] && [ "$has_global" -eq 0 ]; then
    if [ "${#REMAINING_ARGS[@]}" -gt 0 ]; then
      "$npx_cmd" skills@latest add "$source" --global "${REMAINING_ARGS[@]}"
    else
      "$npx_cmd" skills@latest add "$source" --global
    fi
  else
    if [ "${#REMAINING_ARGS[@]}" -gt 0 ]; then
      "$npx_cmd" skills@latest add "$source" "${REMAINING_ARGS[@]}"
    else
      "$npx_cmd" skills@latest add "$source"
    fi
  fi
}

cmd_add() {
  local project_option input source default_scope entry project arg scope_override=''
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -gt 0 ] || die "add requires a skill name or source"

  input=${REMAINING_ARGS[0]}
  if [ "${#REMAINING_ARGS[@]}" -gt 1 ]; then
    REMAINING_ARGS=("${REMAINING_ARGS[@]:1}")
  else
    REMAINING_ARGS=()
  fi

  if self_skill_exists "$input"; then
    [ "${#REMAINING_ARGS[@]}" -eq 0 ] || die "self-built skill add does not accept skills add options: $input"
    project=$(project_root "$project_option")
    preflight_skill_sources "$input"
    preflight_link_targets "$project" "$input"
    ensure_init "$project"
    cmd_link --project "$project" "$input"
    return
  fi

  if entry=$(catalog_lookup "$input"); then
    source=$(printf '%s\n' "$entry" | cut -f2)
    default_scope=$(printf '%s\n' "$entry" | cut -f3)
  elif looks_like_skill_source "$input"; then
    source=$input
    default_scope=project
  else
    die "unknown skill: $input"
  fi

  local add_args=()
  while [ "${#REMAINING_ARGS[@]}" -gt 0 ]; do
    arg=${REMAINING_ARGS[0]}
    case "$arg" in
      --scope)
        [ "${#REMAINING_ARGS[@]}" -ge 2 ] || die "--scope requires project or global"
        scope_override=${REMAINING_ARGS[1]}
        case "$scope_override" in
          project|global) ;;
          *) die "--scope must be project or global" ;;
        esac
        if [ "${#REMAINING_ARGS[@]}" -gt 2 ]; then
          REMAINING_ARGS=("${REMAINING_ARGS[@]:2}")
        else
          REMAINING_ARGS=()
        fi
        ;;
      --scope=*)
        scope_override=${arg#--scope=}
        case "$scope_override" in
          project|global) ;;
          *) die "--scope must be project or global" ;;
        esac
        if [ "${#REMAINING_ARGS[@]}" -gt 1 ]; then
          REMAINING_ARGS=("${REMAINING_ARGS[@]:1}")
        else
          REMAINING_ARGS=()
        fi
        ;;
      *)
        add_args+=("$arg")
        if [ "${#REMAINING_ARGS[@]}" -gt 1 ]; then
          REMAINING_ARGS=("${REMAINING_ARGS[@]:1}")
        else
          REMAINING_ARGS=()
        fi
        ;;
    esac
  done

  if [ -n "$scope_override" ]; then
    default_scope=$scope_override
  fi

  if [ "${#add_args[@]}" -gt 0 ]; then
    run_third_party_add "$source" "$default_scope" "${add_args[@]}"
  else
    run_third_party_add "$source" "$default_scope"
  fi
}

cmd_link() {
  local project_option project name target src resolved
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -gt 0 ] || die "link requires at least one skill name"

  project=$(project_root "$project_option")
  preflight_skill_sources "${REMAINING_ARGS[@]}"
  preflight_link_targets "$project" "${REMAINING_ARGS[@]}"
  ensure_init "$project"

  for name in "${REMAINING_ARGS[@]}"; do
    target=$project/.agents/skills/$name
    src=$(skill_source "$name")
    resolved=$(canonical_dir "$src")
    if [ -L "$target" ]; then
      printf 'already linked: %s -> %s\n' "$target" "$resolved"
    else
      ln -s "$resolved" "$target"
      printf 'linked: %s -> %s\n' "$target" "$resolved"
    fi
  done
}

cmd_unlink() {
  local project_option project name target
  parse_project_option project_option "$@"
  [ "${#REMAINING_ARGS[@]}" -gt 0 ] || die "unlink requires at least one skill name"

  project=$(project_root "$project_option")
  preflight_unlink_targets "$project" "${REMAINING_ARGS[@]}"

  for name in "${REMAINING_ARGS[@]}"; do
    target=$project/.agents/skills/$name
    if [ -L "$target" ]; then
      rm "$target"
      printf 'unlinked: %s\n' "$target"
    else
      printf 'already absent: %s\n' "$target"
    fi
  done
}

MY_SKILLS_HOME=${MY_SKILLS_HOME:-$(script_home)}
MY_SKILLS_HOME=$(canonical_dir "$MY_SKILLS_HOME") || die "MY_SKILLS_HOME is not a directory: $MY_SKILLS_HOME"

REMAINING_ARGS=()

case "${1:-}" in
  list)
    shift
    cmd_list "$@"
    ;;
  external)
    shift
    cmd_external "$@"
    ;;
  add)
    shift
    cmd_add "$@"
    ;;
  init)
    shift
    cmd_init "$@"
    ;;
  link)
    shift
    cmd_link "$@"
    ;;
  unlink)
    shift
    cmd_unlink "$@"
    ;;
  --help|-h)
    usage
    ;;
  '')
    usage >&2
    exit 1
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
